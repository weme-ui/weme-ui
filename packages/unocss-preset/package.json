{
  "name": "@weme-ui/unocss-preset",
  "type": "module",
  "version": "0.2.1",
  "packageManager": "bun@1.4.3",
  "description": "UnoCSS preset for Weme UI.",
  "author": "Allen Luo <luoyi@mouji.net>",
  "license": "MIT",
  "homepage": "https://mouji.net/weme-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/weme-ui.git",
    "directory": "packages/unocss-preset"
  },
  "bugs": {
    "url": "https://github.com/weme-ui/weme-ui/issues"
  },
  "keywords": [
    "unocss",
    "preset",
    "radix-colors",
    "weme-ui"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./colors": {
      "types": "./dist/colors.d.ts",
      "import": "./dist/colors.js",
      "default": "./dist/colors.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "!dist/**/*.map",
    "CHANGELOG.md",
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "NODE_ENV=deploy tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "play": "NODE_ENV=development bun run --cwd playground dev",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "export:colors": "bun run scripts/export-colors.ts",
    "prepack": "bun ../../scripts/materialize-catalog.ts"
  },
  "peerDependencies": {
    "@radix-ui/colors": "^3.0.0",
    "unocss": "^66.10.5"
  },
  "dependencies": {
    "@unocss/core": "catalog:dev",
    "@unocss/extractor-arbitrary-variants": "catalog:dev",
    "@unocss/rule-utils": "catalog:dev",
    "@unocss/transformer-variant-group": "catalog:dev",
    "bezier-easing": "^3.2.0",
    "colorjs.io": "^0.7.1",
    "defu": "catalog:utils"
  },
  "devDependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@types/node": "catalog:dev",
    "tsdown": "catalog:build",
    "type-fest": "catalog:utils",
    "typescript": "catalog:build",
    "vitest": "catalog:dev"
  }
}
