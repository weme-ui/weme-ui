{
  "name": "weme-ui",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "author": "Allen Luo <luoyi@mouji.net>",
  "license": "MIT",
  "homepage": "https://github.com/weme-ui/weme-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/weme-ui.git"
  },
  "bugs": {
    "url": "https://github.com/weme-ui/weme-ui/issues"
  },
  "workspaces": [
    "packages/*",
    "registry/*"
  ],
  "catalogs": {
    "build": {
      "@antfu/eslint-config": "^9.0.0",
      "@commitlint/cli": "^21.0.2",
      "@commitlint/config-conventional": "^21.0.2",
      "@types/bun": "^1.4.2",
      "@unocss/eslint-plugin": "^66.10.5",
      "bumpp": "^12.3.0",
      "eslint-plugin-format": "^2.0.1",
      "eslint": "^10.4.1",
      "lint-staged": "^17.0.7",
      "simple-git-hooks": "^2.13.1",
      "tsdown": "^0.22.3",
      "turbo": "^2.11.7",
      "typescript": "6.0.3"
    },
    "dev": {
      "@types/node": "^25.9.1",
      "@vitejs/plugin-vue": "^6.0.9",
      "@vue/test-utils": "^2.5.1",
      "happy-dom": "^20.14.5",
      "unocss": "^66.10.5",
      "unplugin-auto-import": "^21.1.0",
      "unplugin-vue-components": "^32.1.0",
      "vite": "^8.3.0",
      "vitest": "^4.1.8",
      "vue-router": "^5.3.1",
      "vue": "^3.5.43"
    },
    "utils": {
      "@iconify-json/ri": "^1.2.10",
      "@iconify/vue": "^5.0.3",
      "@vueuse/core": "^15.0.0",
      "clsx": "^2.1.1",
      "defu": "^6.1.7",
      "premove": "^4.0.0",
      "reka-ui": "^2.11.0",
      "serve": "^14.2.6",
      "tailwind-merge": "^3.7.0",
      "tailwind-variants": "^3.3.1",
      "type-fest": "^5.10.0",
      "zod": "^4.4.3"
    }
  },
  "engines": {
    "node": ">=22.14.0",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "build": "turbo run build build:docs",
    "dev": "turbo run dev --ui=tui",
    "dev:preset": "turbo run dev --ui=tui --filter=@weme-ui/unocss-preset",
    "dev:website": "turbo run dev --ui=tui --filter=@weme-ui/website",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "publish": "turbo run publish",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:build",
    "@commitlint/cli": "catalog:build",
    "@commitlint/config-conventional": "catalog:build",
    "@types/bun": "catalog:build",
    "@unocss/eslint-plugin": "catalog:build",
    "eslint": "catalog:build",
    "eslint-plugin-format": "catalog:build",
    "lint-staged": "catalog:build",
    "simple-git-hooks": "catalog:build",
    "tsdown": "catalog:build",
    "turbo": "catalog:build"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "commit-msg": "bunx commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
