{
  "name": "@weme-ui/weme-ui",
  "version": "0.2.4",
  "description": "A CLI to manage Weme UI projects.",
  "keywords": [
    "component",
    "nuxt",
    "registry",
    "typescript",
    "vue"
  ],
  "homepage": "https://mouji.net/weme-ui",
  "bugs": {
    "url": "https://github.com/weme-ui/weme-ui/issues"
  },
  "license": "MIT",
  "author": "Allen Luo <luoyi@mouji.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/weme-ui.git",
    "directory": "packages/cli"
  },
  "bin": {
    "weme-ui": "./dist/index.js"
  },
  "files": [
    "!dist/**/*.map",
    "CHANGELOG.md",
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "NODE_ENV=deploy tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "playground": "bun run src/index.ts",
    "prepack": "bun ../../scripts/materialize-catalog.ts"
  },
  "dependencies": {
    "@weme-ui/schema": "workspace:*",
    "@weme-ui/unocss-preset": "workspace:*",
    "citty": "^0.2.2",
    "defu": "^6.1.7",
    "diff": "^9.0.0",
    "hasha": "^7.0.0",
    "make-fetch-happen": "^16.0.1",
    "nypm": "^0.6.12",
    "ora": "^10.0.0",
    "semver": "^7.8.5",
    "tinyexec": "^1.3.1",
    "tinyglobby": "^0.2.17",
    "ufo": "^1.6.4",
    "valibot": "catalog:utils"
  },
  "devDependencies": {
    "@types/make-fetch-happen": "^10.0.4",
    "@types/node": "catalog:dev",
    "@types/semver": "^7.8.0",
    "pkg-types": "^2.4.0",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "unocss": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "valibot": "^1.5.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.4.4"
}
