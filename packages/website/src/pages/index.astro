---
import LandingLayout from '../layouts/LandingLayout.astro'

const commands = [
  'pnpm dlx @weme-ui/weme-ui init',
  'pnpm dlx @weme-ui/weme-ui add weme-ui/slim/button',
] as const
---

<LandingLayout
  title="Weme UI"
  description="用 CLI 把组件源码装进仓库。组件在 slim。这个仓库是命令。"
>
  <main class="landing">
    <h1 class="display" data-rise style="--i: 0">WEME<span class="dot">.</span></h1>
    <p class="kicker" data-rise style="--i: 1">用 CLI 把组件源码装进仓库。</p>
    <p class="statement" data-rise style="--i: 2">组件在 slim。这个仓库是命令。</p>
    <div class="commands" data-rise style="--i: 3">
      {commands.map(command => (
        <div class="command">
          <code>{command}</code>
          <button
            type="button"
            data-copy-command={command}
            data-label-idle="复制"
            data-label-done="已复制"
          >
            复制
          </button>
        </div>
      ))}
    </div>
  </main>
</LandingLayout>
