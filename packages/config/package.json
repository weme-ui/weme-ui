{
  "name": "@weme-ui/config",
  "version": "6.2.7",
  "description": "Config loader for Weme UI.",
  "keywords": [
    "weme-ui"
  ],
  "homepage": "https://weme-ui.github.io/weme-ui/",
  "bugs": {
    "url": "https://github.com/weme-ui/weme-ui/issues"
  },
  "license": "MIT",
  "author": "Allen Luo <luoyi@mouji.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/weme-ui.git",
    "directory": "packages/config"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./client.d.ts",
    "./loader": "./dist/loader.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc6 --noEmit",
    "prepack": "bun ../../scripts/materialize-catalog.ts"
  },
  "dependencies": {
    "@weme-ui/schema": "workspace:*",
    "valibot": "catalog:utils",
    "vite": "catalog:dev"
  },
  "devDependencies": {
    "@rolldown/pluginutils": "^1.1.1",
    "@types/node": "catalog:dev",
    "@typescript/typescript6": "catalog:build",
    "tsdown": "catalog:build"
  },
  "peerDependencies": {
    "valibot": "^1.5",
    "vite": "^8"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.4.5"
}
