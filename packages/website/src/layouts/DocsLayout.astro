---
import Breadcrumb from '../components/Breadcrumb.astro'
import OnThisPage from '../components/OnThisPage.astro'
import PrevNext from '../components/PrevNext.astro'
import Sidebar from '../components/Sidebar.astro'
import ThemeToggle from '../components/ThemeToggle.vue'
import Icon from '../components/landing/Icon.vue'
import { homeIcons } from '../lib/icons'
import type { AdjacentNavLink, DocNavItem, ComponentTreeSection } from '../lib/registry'
import { getLibraries, withBase } from '../lib/registry'
import type { TocItem } from '../lib/markdown'
import type { UiDependencyBadge } from '../lib/ui-dependencies'

export interface BreadcrumbItem {
  label: string
  href?: string
}

interface Props {
  title: string
  description?: string
  badges?: UiDependencyBadge[]
  library?: string
  docs?: DocNavItem[]
  tree?: ComponentTreeSection[]
  toc?: TocItem[]
  breadcrumbs?: BreadcrumbItem[]
  prev?: AdjacentNavLink | null
  next?: AdjacentNavLink | null
}

const {
  title,
  description,
  badges = [],
  library,
  docs = [],
  tree = [],
  toc = [],
  breadcrumbs = [],
  prev = null,
  next = null,
} = Astro.props

const homeHref = withBase('/')
const githubHref = 'https://github.com/weme-ui/weme-ui'
const logoHref = withBase('/weme.svg')
const libraries = getLibraries()
---

<!doctype html>
<html lang="zh-CN" class="dark" data-scaling="100%" data-radius="xs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={logoHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const key = 'weme-docs-theme'
        const stored = localStorage.getItem(key)
        const dark = stored ? stored === 'dark' : true
        document.documentElement.classList.toggle('dark', dark)
        document.documentElement.classList.toggle('light', !dark)
      })()
    </script>
  </head>
  <body>
    <header class="docs-topbar">
      <div class="docs-topbar-inner">
        <a href={homeHref} class="docs-brand-mark">
          <svg
            class="docs-brand-logo"
            width="28"
            height="28"
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect width="32" height="32" rx="16" fill="#1D2129"></rect>
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M26 16C26 16.492 25.8045 16.9839 25.4135 17.3593L21.1659 21.437C20.3839 22.1877 19.1161 22.1877 18.3341 21.437L16.5304 19.7053L16.5024 19.6798C16.2086 19.425 15.7554 19.433 15.4716 19.7036L13.6659 21.437C12.8839 22.1877 11.6161 22.1877 10.8341 21.437L6.58648 17.3593C6.1955 16.9839 6 16.492 6 16C6 15.508 6.1955 15.0161 6.58648 14.6407L10.8341 10.563C11.6161 9.81233 12.8839 9.81233 13.6659 10.563L15.4716 12.2965C15.7554 12.567 16.2086 12.575 16.5024 12.3202L16.5304 12.2947L18.3341 10.563C19.1161 9.81233 20.3839 9.81234 21.1659 10.563L25.4135 14.6407C25.8045 15.0161 26 15.508 26 16ZM15.9015 16C15.9015 15.835 15.836 15.6701 15.7051 15.5444L13.9071 13.8183C13.9054 13.8166 13.9036 13.815 13.9018 13.8133L12.7204 12.679C12.4603 12.4293 12.0397 12.4293 11.7796 12.679L8.79481 15.5444C8.66394 15.6701 8.59841 15.835 8.59842 16C8.59842 16.165 8.66394 16.3299 8.79481 16.4556L11.7796 19.321C12.0397 19.5707 12.4603 19.5707 12.7204 19.321L13.9018 18.1867C13.9036 18.185 13.9054 18.1834 13.9071 18.1817L15.7051 16.4556C15.836 16.3299 15.9015 16.165 15.9015 16ZM18.5 16C18.5 16.492 18.3045 16.9839 17.9135 17.3593L17.5091 17.7475C17.7192 17.8669 17.9175 18.0133 18.0982 18.1868L19.2795 19.321C19.5396 19.5707 19.9602 19.5707 20.2203 19.321L23.2051 16.4556C23.336 16.3299 23.4015 16.165 23.4015 16C23.4015 15.835 23.336 15.6701 23.2051 15.5444L20.2203 12.679C19.9602 12.4293 19.5396 12.4293 19.2795 12.679L18.0982 13.8132C17.9175 13.9867 17.7192 14.1331 17.5091 14.2525L17.9135 14.6407C18.3045 15.0161 18.5 15.508 18.5 16Z"
              fill="white"
            ></path>
          </svg>
          <span class="docs-brand-text">Weme UI</span>
        </a>

        {libraries.length > 0 && (
          <nav class="docs-product-nav" aria-label="Libraries">
            {libraries.map(item => (
              <a
                href={item.href}
                class:list={['docs-product-link', library === item.id && 'is-active']}
              >
                {item.id}
              </a>
            ))}
          </nav>
        )}

        <div class="docs-topbar-spacer"></div>
        <div class="docs-topbar-actions">
          <ThemeToggle client:load />
          <a
            class="docs-topbar-icon-link"
            href={githubHref}
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <Icon icon={homeIcons.githubFill} width={18} height={18} />
          </a>
        </div>
      </div>
    </header>

    <div class="docs-shell">
      <aside class="docs-sidebar">
        <Sidebar docs={docs} tree={tree} currentPath={Astro.url.pathname} />
      </aside>

      <main class="docs-main">
        <header class="docs-header">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="docs-title">{title}</h1>
          {description && <p class="docs-description">{description}</p>}
          {badges.length > 0 && (
            <div class="docs-badges" aria-label="UI dependencies">
              {badges.map(badge => (
                <a
                  class="docs-badge"
                  href={badge.href}
                  target="_blank"
                  rel="noreferrer"
                >
                  {badge.label}
                </a>
              ))}
            </div>
          )}
        </header>
        <div class="docs-content prose">
          <slot />
        </div>
        <PrevNext prev={prev} next={next} />
      </main>

      <aside class="docs-toc">
        <OnThisPage items={toc} />
      </aside>
    </div>

    <script>
      document.querySelectorAll('.prose pre').forEach((pre) => {
        if (!(pre instanceof HTMLElement) || pre.dataset.copyReady)
          return
        pre.dataset.copyReady = 'true'
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'docs-copy-btn'
        button.setAttribute('aria-label', 'Copy code to clipboard')
        button.innerHTML = '<svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true"><path d="M1 9.5A1.5 1.5 0 002.5 11H6v1H2.5A2.5 2.5 0 010 9.5v-7A2.5 2.5 0 012.5 0H9a2.5 2.5 0 012.5 2.5V5h-1V2.5A1.5 1.5 0 009 1H2.5A1.5 1.5 0 001 2.5v7zM5.5 4A1.5 1.5 0 004 5.5v7A1.5 1.5 0 005.5 14h7a1.5 1.5 0 001.5-1.5v-7A1.5 1.5 0 0012.5 4h-7zM5 5.5A.5.5 0 015.5 5h7a.5.5 0 01.5.5v7a.5.5 0 01-.5.5h-7a.5.5 0 01-.5-.5v-7z" fill="currentColor"/></svg>'
        button.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.textContent || pre.textContent || ''
          try {
            await navigator.clipboard.writeText(code)
            button.classList.add('is-copied')
            window.setTimeout(() => {
              button.classList.remove('is-copied')
            }, 1400)
          }
          catch {
            button.classList.add('is-failed')
            window.setTimeout(() => {
              button.classList.remove('is-failed')
            }, 1400)
          }
        })
        pre.appendChild(button)
      })
    </script>
  </body>
</html>

<style is:global>
  :root,
  .dark {
    --docs-bg: #050506;
    --docs-bg-panel: #0a0a0d;
    --docs-bg-soft: #121217;
    --docs-bg-hover: #1a1a21;
    --docs-bg-code: #07080a;
    --docs-bg-example: #121217;
    --docs-bg-topbar: rgba(5, 5, 6, 0.82);
    --docs-ink: #f4f4f6;
    --docs-ink-soft: #b4b6c0;
    --docs-muted: #7c7e8a;
    --docs-border: #1c1c22;
    --docs-border-strong: #2a2a33;
    --docs-accent: #4cbba5;
    --docs-accent-soft: rgba(76, 187, 165, 0.14);
    --docs-accent-ink: #7ad9c4;
    --docs-product-active-ink: #062019;
    --docs-sidebar-width: 256px;
    --docs-toc-width: 220px;
    --docs-topbar-height: 56px;
    --docs-radius: 0.65rem;
    --docs-font-sans: "Outfit", "PingFang SC", "Noto Sans SC", sans-serif;
    --docs-font-mono: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;
  }

  .light {
    --docs-bg: #f6f7f9;
    --docs-bg-panel: #ffffff;
    --docs-bg-soft: #eef0f4;
    --docs-bg-hover: #e4e7ee;
    --docs-bg-code: #f0f2f6;
    --docs-bg-example: #f3f5f8;
    --docs-bg-topbar: rgba(246, 247, 249, 0.88);
    --docs-ink: #12141a;
    --docs-ink-soft: #3f4554;
    --docs-muted: #6b7280;
    --docs-border: #e2e5ec;
    --docs-border-strong: #cfd5e0;
    --docs-accent: #2f9d87;
    --docs-accent-soft: rgba(47, 157, 135, 0.12);
    --docs-accent-ink: #1f7a69;
    --docs-product-active-ink: #062019;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html.dark {
    color-scheme: dark;
  }

  html.light {
    color-scheme: light;
  }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--docs-ink);
    background: var(--docs-bg);
    font-family: var(--docs-font-sans);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .docs-topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--docs-topbar-height);
    border-bottom: 1px solid var(--docs-border);
    background: var(--docs-bg-topbar);
    backdrop-filter: blur(14px);
  }

  .docs-topbar-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .docs-brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .docs-brand-logo {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
  }

  .docs-brand-text {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }

  .docs-product-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.18rem;
    border-radius: 999px;
    background: var(--docs-bg-soft);
    border: 1px solid var(--docs-border);
  }

  .docs-product-link {
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    color: var(--docs-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: lowercase;
    transition: background 120ms ease, color 120ms ease;
  }

  .docs-product-link:hover {
    color: var(--docs-ink);
  }

  .docs-product-link.is-active {
    background: var(--docs-accent);
    color: var(--docs-product-active-ink);
  }

  .docs-topbar-spacer {
    flex: 1;
  }

  .docs-topbar-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .docs-theme-toggle,
  .docs-topbar-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border: 1px solid var(--docs-border);
    border-radius: 0.5rem;
    color: var(--docs-ink-soft);
    background: var(--docs-bg-soft);
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
  }

  .docs-theme-toggle:hover,
  .docs-topbar-icon-link:hover {
    color: var(--docs-ink);
    border-color: var(--docs-border-strong);
    background: var(--docs-bg-hover);
  }

  .docs-theme-toggle:focus-visible,
  .docs-topbar-icon-link:focus-visible {
    outline: 2px solid var(--docs-accent);
    outline-offset: 2px;
  }

  .docs-shell {
    display: grid;
    grid-template-columns: var(--docs-sidebar-width) minmax(0, 1fr) var(--docs-toc-width);
    min-height: calc(100vh - var(--docs-topbar-height));
    max-width: 1600px;
    margin: 0 auto;
  }

  .docs-sidebar,
  .docs-toc {
    position: sticky;
    top: var(--docs-topbar-height);
    height: calc(100vh - var(--docs-topbar-height));
    overflow: auto;
    background: var(--docs-bg-panel);
  }

  .docs-sidebar {
    border-right: 1px solid var(--docs-border);
    padding: 1.1rem 0.75rem 2.5rem;
  }

  .docs-toc {
    border-left: 1px solid var(--docs-border);
    padding: 1.5rem 0.9rem 2.5rem;
  }

  .docs-nav-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0.25rem 1.1rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--docs-border);
    border-radius: var(--docs-radius);
    background: var(--docs-bg-soft);
    color: var(--docs-muted);
  }

  .docs-nav-search:focus-within {
    border-color: color-mix(in srgb, var(--docs-accent) 45%, var(--docs-border));
    box-shadow: 0 0 0 2px var(--docs-accent-soft);
    color: var(--docs-accent-ink);
  }

  .docs-nav-search input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--docs-ink);
    font: inherit;
    font-size: 0.85rem;
  }

  .docs-nav-search input::placeholder {
    color: var(--docs-muted);
  }

  .docs-nav-section + .docs-nav-section {
    margin-top: 1.15rem;
  }

  .nav-section-title {
    margin: 0 0 0.35rem;
    padding: 0 0.65rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--docs-ink);
  }

  .nav-category {
    margin: 0.55rem 0 0.15rem;
    padding: 0 0.65rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--docs-muted);
  }

  .nav-link {
    display: block;
    margin: 0.05rem 0;
    padding: 0.38rem 0.65rem;
    border-radius: 0.45rem;
    color: var(--docs-ink-soft);
    font-size: 0.875rem;
    line-height: 1.35;
    transition: background 120ms ease, color 120ms ease;
  }

  .nav-link:hover {
    background: var(--docs-bg-hover);
    color: var(--docs-ink);
  }

  .nav-link[aria-current="page"] {
    background: var(--docs-accent-soft);
    color: var(--docs-accent-ink);
    font-weight: 500;
  }

  .docs-main {
    padding: 2rem 2.75rem 4.5rem;
    max-width: 780px;
    width: 100%;
    justify-self: center;
  }

  .docs-header {
    margin-bottom: 2rem;
  }

  .docs-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem;
    margin: 0 0 0.9rem;
    padding: 0;
    list-style: none;
    color: var(--docs-muted);
    font-size: 0.8rem;
  }

  .docs-breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .docs-breadcrumb a:hover {
    color: var(--docs-accent-ink);
  }

  .docs-breadcrumb [aria-current="page"] {
    color: var(--docs-ink-soft);
  }

  .docs-breadcrumb-sep {
    margin: 0 0.2rem;
    opacity: 0.5;
  }

  .docs-title {
    margin: 0;
    font-size: clamp(1.85rem, 2.5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .docs-description {
    margin: 0.65rem 0 0;
    color: var(--docs-ink-soft);
    font-size: 1.05rem;
    line-height: 1.55;
    max-width: 40rem;
  }

  .docs-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.95rem;
  }

  .docs-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.65rem;
    border: 1px solid var(--docs-border-strong);
    border-radius: 999px;
    background: var(--docs-bg-soft);
    color: var(--docs-ink-soft);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
  }

  .docs-badge:hover {
    border-color: color-mix(in srgb, var(--docs-accent) 45%, var(--docs-border-strong));
    color: var(--docs-accent-ink);
    background: var(--docs-accent-soft);
  }

  /*
   * Docs typography must not cascade into component previews.
   * Mark preview islands with `.not-prose` (see ExamplePreview stage body)
   * and exclude them via `:not(:where(.not-prose, .not-prose *))`.
   */
  .prose > :first-child {
    margin-top: 0;
  }

  .prose :where(h1):not(:where(.not-prose, .not-prose *)) {
    display: none;
  }

  .prose :where(h2, h3):not(:where(.not-prose, .not-prose *)) {
    scroll-margin-top: calc(var(--docs-topbar-height) + 1rem);
    letter-spacing: -0.02em;
  }

  .prose :where(h2):not(:where(.not-prose, .not-prose *)) {
    margin: 2.5rem 0 0.7rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .prose .docs-files {
    margin-top: 4.5rem;
    padding-top: 0.5rem;
  }

  .prose .docs-files > h2 {
    margin-top: 0;
  }

  .prose :where(h2):not(:where(.not-prose, .not-prose *)):first-child {
    margin-top: 0;
  }

  .prose :where(h3):not(:where(.not-prose, .not-prose *)) {
    margin: 1.65rem 0 0.45rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .prose :where(p, li):not(:where(.not-prose, .not-prose *)) {
    line-height: 1.7;
    color: var(--docs-ink-soft);
  }

  .prose :where(a):not(:where(.not-prose, .not-prose *)) {
    color: var(--docs-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--docs-accent) 40%, transparent);
    text-underline-offset: 0.16em;
  }

  .prose :where(a):not(:where(.not-prose, .not-prose *)):hover {
    text-decoration-color: var(--docs-accent);
  }

  .prose :where(strong):not(:where(.not-prose, .not-prose *)) {
    color: var(--docs-ink);
    font-weight: 600;
  }

  .prose :where(code):not(:where(.not-prose, .not-prose *)) {
    font-family: var(--docs-font-mono);
    font-size: 0.86em;
    background: var(--docs-bg-soft);
    color: var(--docs-accent-ink);
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    border: 1px solid var(--docs-border);
  }

  .prose :where(pre):not(:where(.not-prose, .not-prose *)) {
    position: relative;
    margin: 0.9rem 0 1.35rem;
    padding: 0.95rem 1.05rem;
    overflow: auto;
    border: 1px solid var(--docs-border-strong);
    border-radius: var(--docs-radius);
    background: var(--docs-bg-code);
    color: var(--docs-ink-soft);
    font-family: var(--docs-font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .prose :where(pre code):not(:where(.not-prose, .not-prose *)) {
    background: transparent;
    border: 0;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .docs-copy-btn {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    appearance: none;
    border: 1px solid transparent;
    border-radius: 0.4rem;
    background: transparent;
    color: var(--docs-muted);
    cursor: pointer;
  }

  .docs-copy-btn:hover {
    color: var(--docs-ink);
    background: var(--docs-bg-soft);
    border-color: var(--docs-border);
  }

  .docs-copy-btn.is-copied {
    color: var(--docs-accent-ink);
  }

  .docs-copy-btn.is-failed {
    color: #f07676;
  }

  .prose :where(table):not(:where(.not-prose, .not-prose *)) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.9rem;
    border: 1px solid var(--docs-border);
    border-radius: var(--docs-radius);
    overflow: hidden;
  }

  .prose :where(thead):not(:where(.not-prose, .not-prose *)) {
    background: var(--docs-bg-soft);
  }

  .prose :where(th, td):not(:where(.not-prose, .not-prose *)) {
