{
  "name": "@weme-ui/weme-ui",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "description": "A CLI to manage Weme UI projects.",
  "author": "Allen Luo <luoyi@mouji.net>",
  "license": "MIT",
  "homepage": "https://mouji.net/weme-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/weme-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/weme-ui/weme-ui/issues"
  },
  "keywords": [
    "component",
    "registry",
    "typescript",
    "vue",
    "nuxt"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "bin": {
    "weme-ui": "./dist/bin.js"
  },
  "files": [
    "!dist/**/*.map",
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22.14.0",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "build": "NODE_ENV=deploy tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "tsdown": "catalog:build",
    "zod": "catalog:utils"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
