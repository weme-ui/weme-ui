{
  "name": "weme-ui",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/weme-ui/weme-ui",
  "bugs": {
    "url": "https://github.com/weme-ui/weme-ui/issues"
  },
  "license": "MIT",
  "author": "Allen Luo <luoyi@mouji.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/weme-ui.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build build:docs",
    "dev": "turbo run dev --ui=tui",
    "dev:preset": "turbo run dev --ui=tui --filter=@weme-ui/unocss-preset",
    "dev:website": "turbo run dev --ui=tui --filter=@weme-ui/website",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "release": "bun run --filter @weme-ui/schema --filter @weme-ui/unocss-preset --filter @weme-ui/weme-ui --filter @weme-ui/colors build && bun run --filter @weme-ui/schema build:output && changeset publish",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:build",
    "@changesets/cli": "catalog:build",
    "@commitlint/cli": "catalog:build",
    "@commitlint/config-conventional": "catalog:build",
    "@types/bun": "catalog:build",
    "lint-staged": "catalog:build",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "simple-git-hooks": "catalog:build",
    "tsdown": "catalog:build",
    "tsrs": "catalog:build",
    "turbo": "catalog:build"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "commit-msg": "bunx commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "oxlint --fix --no-error-on-unmatched-pattern"
  },
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=22.23.4"
  },
  "packageManager": "bun@1.4.4",
  "catalogs": {
    "build": {
      "@changesets/changelog-github": "^1.0.1",
      "@changesets/cli": "^3.0.3",
      "@commitlint/cli": "^21.0.2",
      "@commitlint/config-conventional": "^21.0.2",
      "@types/bun": "^1.4.2",
      "lint-staged": "^17.0.7",
      "oxfmt": "^0.77.0",
      "oxlint": "^1.92.0",
      "simple-git-hooks": "^2.13.1",
      "tsdown": "^0.22.3",
      "tsrs": "^0.23.0-ts7.1.0-beta",
      "turbo": "^2.11.7",
      "typescript": "6.0.3"
    },
    "dev": {
      "@testing-library/vue": "^8.1.0",
      "@types/node": "^25.9.1",
      "@unocss/astro": "^66.12.0",
      "@unocss/core": "^66.12.0",
      "@unocss/extractor-arbitrary-variants": "^66.12.0",
      "@unocss/rule-utils": "^66.12.0",
      "@unocss/transformer-variant-group": "^66.12.0",
      "@vitejs/plugin-vue": "^6.0.9",
      "@vue/server-renderer": "^3.5.43",
      "@vue/test-utils": "^2.5.1",
      "happy-dom": "^20.14.5",
      "unocss": "^66.12.0",
      "unplugin-auto-import": "^21.1.0",
      "unplugin-vue-components": "^32.1.0",
      "vite": "^8.3.0",
      "vitest-axe": "^0.1.0",
      "vitest": "^4.1.8",
      "vue-router": "^5.3.1",
      "vue-tsc": "^3.3.13",
      "vue": "^3.5.43"
    },
    "utils": {
      "@iconify-json/ri": "^1.2.10",
      "@iconify/vue": "^5.0.3",
      "@tanstack/vue-form": "^1.33.5",
      "@vueuse/core": "^15.0.0",
      "clsx": "^2.1.1",
      "defu": "^6.1.7",
      "escape-string-regexp": "^5.0.0",
      "motion-v": "^2.7.0",
      "premove": "^4.0.0",
      "reka-ui": "^2.11.0",
      "serve": "^14.2.6",
      "tailwind-merge": "^3.7.0",
      "tailwind-variants": "^3.3.1",
      "type-fest": "^5.10.0",
      "valibot": "^1.5.0"
    }
  }
}
