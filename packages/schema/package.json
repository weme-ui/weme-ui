{
  "name": "@weme-ui/schema",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "description": "JSON schema sources for Weme UI.",
  "author": "Allen Luo <luoyi@mouji.net>",
  "license": "MIT",
  "homepage": "https://mouji.net/weme-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/weme-ui.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/weme-ui/weme-ui/issues"
  },
  "keywords": [
    "weme-ui",
    "schema"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "!dist/**/*.map",
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22.14.0",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "build": "NODE_ENV=deploy tsdown",
    "build:output": "bun run scripts/build.ts",
    "build:docs": "premove ./docs && jsonschema2md -d ./dist -x ../website/public -o ./docs",
    "dev": "NODE_ENV=development tsdown --watch",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "publish": "bun ../../scripts/publish.ts",
    "preview": "serve -l 3000"
  },
  "peerDependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@adobe/jsonschema2md": "^8.0.11",
    "@types/node": "catalog:dev",
    "@valibot/to-json-schema": "^1.8.0",
    "bumpp": "catalog:build",
    "premove": "catalog:utils",
    "serve": "catalog:utils",
    "tsdown": "catalog:build",
    "valibot": "catalog:utils"
  }
}
