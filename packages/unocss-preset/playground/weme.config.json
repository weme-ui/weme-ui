{
  "$schema": "https://weme-ui.github.io/weme-ui/config.schema.json",
  "paths": {
    "~": "src",
    "component": "~/components",
    "composable": "~/composables",
    "block": "~/blocks",
    "layout": "~/layouts",
    "page": "~/pages",
    "util": "~/utils",
    "theme": "~/themes"
  },
  "registries": [
    {
      "registry": "weme-ui/slim",
      "prefix": "ui"
    }
  ],
  "unocss": {
    "cssVars": {
      "activity-bar": {
        "width": "3.5rem",
        "active-bg": "neutral.3",
        "active-color": "neutral.12"
      },
      "scrollbar": {
        "color": "neutral.3",
        "thumb-color": "neutral.8",
        "thumb-hover-color": "neutral.9"
      },
      "tooltip": {
        "background": "neutral.12",
        "color": "neutral.1"
      }
    }
  }
}
