{
  "name": "@weme-ui/unocss-preset",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "description": "UnoCSS preset for Weme UI.",
  "author": "Allen Luo <luoyi@mouji.net>",
  "license": "MIT",
  "homepage": "https://mouji.net/weme-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/weme-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/weme-ui/weme-ui/issues"
  },
  "keywords": [
    "unocss",
    "preset",
    "radix-colors",
    "weme-ui"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./colors": {
      "types": "./dist/colors.d.ts",
      "import": "./dist/colors.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "!dist/**/*.map",
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22.14.0",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "build": "NODE_ENV=deploy tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run"
  },
  "peerDependencies": {
    "@radix-ui/colors": "^3.0.0",
    "unocss": "^66.10.5"
  },
  "devDependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@types/node": "catalog:dev",
    "@unocss/core": "^66.10.5",
    "@unocss/extractor-arbitrary-variants": "^66.10.5",
    "@unocss/rule-utils": "^66.10.5",
    "bezier-easing": "^3.1.0",
    "colorjs.io": "^0.7.1",
    "tsdown": "catalog:build",
    "unocss": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
