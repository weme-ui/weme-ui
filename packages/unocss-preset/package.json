{
  "name": "@weme-ui/unocss-preset",
  "version": "0.6.0",
  "description": "UnoCSS preset for Weme UI.",
  "keywords": [
    "radix-colors",
    "tailwindcss4",
    "unocss",
    "unocss-preset",
    "weme-ui"
  ],
  "homepage": "https://mouji.net/weme-ui",
  "bugs": {
    "url": "https://github.com/weme-ui/weme-ui/issues"
  },
  "license": "MIT",
  "author": "Allen Luo <luoyi@mouji.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/weme-ui.git",
    "directory": "packages/unocss-preset"
  },
  "files": [
    "!dist/**/*.map",
    "CHANGELOG.md",
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*",
        "dist/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "NODE_ENV=deploy tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "play": "NODE_ENV=development bun run --cwd playground dev",
    "typecheck": "tsc6 --noEmit",
    "test": "NODE_ENV=test vitest run",
    "prepack": "bun ../../scripts/materialize-catalog.ts"
  },
  "dependencies": {
    "@unocss/core": "catalog:dev",
    "@unocss/extractor-arbitrary-variants": "catalog:dev",
    "@unocss/rule-utils": "catalog:dev",
    "@unocss/transformer-variant-group": "catalog:dev"
  },
  "devDependencies": {
    "@radix-ui/colors": "catalog:utils",
    "@types/node": "catalog:dev",
    "@typescript/typescript6": "catalog:build",
    "@weme-ui/colors": "workspace:*",
    "bezier-easing": "catalog:utils",
    "colorjs.io": "catalog:utils",
    "defu": "catalog:utils",
    "tsdown": "catalog:build",
    "type-fest": "catalog:utils",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "unocss": "^66.12.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.4.4"
}
