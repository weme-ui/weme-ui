{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:output": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "build:docs": {
      "dependsOn": ["build:output"],
      "outputs": ["docs/**"]
    }
  }
}
