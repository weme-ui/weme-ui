{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:output": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "build:docs": {
      "dependsOn": ["build:output"],
      "outputs": ["../../docs/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "publish": {
      "dependsOn": ["build", "^publish"],
      "cache": false
    }
  }
}
