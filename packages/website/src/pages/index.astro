---
import DocsLayout from '../layouts/DocsLayout.astro'
import { getLibraries } from '../lib/registry'

const libraries = getLibraries()
---

<DocsLayout
  title="Weme UI Docs"
  description="Registry 组件库与 packages 文档统一由文档站展示。"
>
  {libraries.map(library => (
    <a class="library-card" href={library.href}>
      <strong>{library.name}</strong>
      {library.description && <p>{library.description}</p>}
      <small>
        {library.source === 'package' ? 'package' : 'registry'}
        {library.version ? ` · v${library.version}` : ''}
      </small>
    </a>
  ))}

  {libraries.length === 0 && (
    <p>暂无可用文档。</p>
  )}
</DocsLayout>
