---
import '../styles/base.css'
import '../styles/page.css'
import '../styles/docs.css'
import { withBase } from '../lib/base'

interface Props {
  title: string
  description?: string
  section?: 'preset'
}

const { title, description, section } = Astro.props
const home = withBase('/')
const preset = withBase('/docs/unocss-preset/')
const year = new Date().getFullYear()
const logoHref = withBase('/weme.svg')
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={logoHref} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <header class="site-nav">
      <a class="brand" href={home}>WEME<span class="dot">.</span></a>
      <nav class="nav-links" aria-label="页面">
        <a href="https://github.com/weme-ui/weme-ui" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://weme-ui.github.io/slim" target="_blank" rel="noreferrer">slim</a>
        <a href={preset} aria-current={section === 'preset' ? 'page' : undefined}>Preset</a>
      </nav>
    </header>
    <slot />
    <footer class="site-foot">
      <span>早期开发，请勿用于生产</span>
      <span>MIT · {year}</span>
    </footer>
    <script src="../scripts/page.ts"></script>
  </body>
</html>
