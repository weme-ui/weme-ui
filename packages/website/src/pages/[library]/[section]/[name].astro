---
import ExamplePreview from '../../../components/ExamplePreview.astro'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import {
  renderMarkdown,
  slugifyHeading,
  splitMarkdownH2,
  stripLeadingH1,
  type MarkdownH2Section,
  type TocItem,
} from '../../../lib/markdown'
import {
  getAdjacentNav,
  getAllItemPages,
  getItemPage,
  getLibrary,
  getSectionLabel,
  withBase,
} from '../../../lib/registry'
import { resolveUiDependencyBadges } from '../../../lib/ui-dependencies'

export function getStaticPaths() {
  return getAllItemPages().map(page => ({
    params: {
      library: page.library,
      section: page.section,
      name: page.name,
    },
  }))
}

const { library: libraryId, section, name } = Astro.params
const library = getLibrary(libraryId!)
const page = getItemPage(libraryId!, section!, name!)

if (!library || !page) {
  throw new Error(`Unknown item page: ${libraryId}/${section}/${name}`)
}

/** README h2 titles omitted from the page (website injects Examples; Preview/Source are unused). */
const OMIT_SECTIONS = new Set(['preview', 'examples', 'source'])

/** Fixed detail-page order: Installation → Usage → (other lead) → Examples → Props… → CSS Variables → Accessibility → Files */
const LEAD_TITLES = new Set(['installation', 'usage'])
const API_TITLES = ['props', 'events', 'slots'] as const
const CSS_VARIABLES_TITLE = 'css variables'
const ACCESSIBILITY_TITLE = 'accessibility'

const readmeBody = page.readme ? stripLeadingH1(page.readme) : ''
const sections = splitMarkdownH2(readmeBody).filter((section) => {
  return !OMIT_SECTIONS.has(section.title.trim().toLowerCase())
})

function sectionKey(section: MarkdownH2Section) {
  return section.title.trim().toLowerCase()
}

function findSection(title: string) {
  return sections.find(section => sectionKey(section) === title)
}

const leadSections = sections.filter(section => LEAD_TITLES.has(sectionKey(section)))
const otherLeadSections = sections.filter((section) => {
  const key = sectionKey(section)
  return !LEAD_TITLES.has(key)
    && !(API_TITLES as readonly string[]).includes(key)
    && key !== CSS_VARIABLES_TITLE
    && key !== ACCESSIBILITY_TITLE
})
const apiSections = API_TITLES
  .map(title => findSection(title))
  .filter((section): section is MarkdownH2Section => Boolean(section))
const cssVariablesSection = findSection(CSS_VARIABLES_TITLE)
const accessibilitySection = findSection(ACCESSIBILITY_TITLE)

const usageExample = page.exampleModules.find(example => example.name === 'usage')
const featureExamples = page.exampleModules.filter(example => example.name !== 'usage')

const usedIds = new Map<string, number>()
const toc: TocItem[] = []

function pushToc(text: string, level: number): string {
  const id = slugifyHeading(text, usedIds)
  toc.push({ id, text, level })
  return id
}

function renderHeading(title: string): { id: string, html: string } {
  const id = pushToc(title, 2)
  return {
    id,
    html: `<h2 id="${id}">${title}</h2>`,
  }
}

async function renderBody(body: string): Promise<string> {
  return body.trim() ? await renderMarkdown(body) : ''
}

async function renderSection(title: string, body: string): Promise<string> {
  const { html: heading } = renderHeading(title)
  const bodyHtml = await renderBody(body)
  return bodyHtml ? `${heading}\n${bodyHtml}` : heading
}

type ContentBlock = {
  headingHtml: string
  previewPath?: string
  bodyHtml: string
}

async function toLeadBlocks(list: MarkdownH2Section[]): Promise<ContentBlock[]> {
  return Promise.all(list.map(async (section) => {
    const isUsage = sectionKey(section) === 'usage'
    const attachUsage = isUsage ? usageExample : undefined

    if (attachUsage) {
      return {
        headingHtml: renderHeading(section.title).html,
        previewPath: attachUsage.path,
        bodyHtml: '',
      }
    }

    return {
      headingHtml: '',
      bodyHtml: await renderSection(section.title, section.body),
    }
  }))
}

const leadBlocks = await toLeadBlocks([...leadSections, ...otherLeadSections])

const hasUsageSection = leadSections.some(section => sectionKey(section) === 'usage')
const orphanUsageId = usageExample && !hasUsageSection ? pushToc('Usage', 2) : null

const examplesId = featureExamples.length > 0 ? pushToc('Examples', 2) : null
const exampleHeadingIds = featureExamples.map(example => pushToc(example.title, 3))

const apiHtml = (await Promise.all(
  apiSections.map(section => renderSection(section.title, section.body)),
)).join('\n')

const cssVariablesHtml = cssVariablesSection
  ? await renderSection(cssVariablesSection.title, cssVariablesSection.body)
  : ''

const accessibilityHtml = accessibilitySection
  ? await renderSection(accessibilitySection.title, accessibilitySection.body)
  : ''

const filesId = page.sourceFiles.length > 0 ? pushToc('Files', 2) : null

const badges = resolveUiDependencyBadges(page.item.dependencies)
const adjacent = getAdjacentNav(library.id, page.href)
const sectionLabel = getSectionLabel(section!)

const emptyHtml = leadBlocks.length === 0
  && !usageExample
  && featureExamples.length === 0
  && !apiHtml
  && !cssVariablesHtml
  && !accessibilityHtml
  ? '<p>暂无 README。</p>'
  : ''
---

<DocsLayout
  title={page.title}
  description={page.description}
  badges={badges}
  library={library.id}
  docs={library.docs}
  tree={library.tree}
  toc={toc}
  breadcrumbs={[
    { label: 'Home', href: withBase('/') },
    { label: library.id, href: withBase(`/${library.id}/`) },
    { label: sectionLabel },
    { label: page.title },
  ]}
  prev={adjacent.prev}
  next={adjacent.next}
>
  {leadBlocks.map(block => (
    <Fragment>
      {block.headingHtml && <Fragment set:html={block.headingHtml} />}
      {block.previewPath && (
        <ExamplePreview examplePath={block.previewPath} />
      )}
      {block.bodyHtml && <Fragment set:html={block.bodyHtml} />}
    </Fragment>
  ))}

  {orphanUsageId && usageExample && (
    <section>
      <h2 id={orphanUsageId}>Usage</h2>
      <ExamplePreview examplePath={usageExample.path} />
    </section>
  )}

  {featureExamples.length > 0 && examplesId && (
    <section>
      <h2 id={examplesId}>Examples</h2>
      {featureExamples.map((example, index) => (
        <Fragment>
          <h3 id={exampleHeadingIds[index]}>{example.title}</h3>
          <ExamplePreview examplePath={example.path} />
        </Fragment>
      ))}
    </section>
  )}

  <Fragment set:html={apiHtml} />
  <Fragment set:html={cssVariablesHtml} />
  <Fragment set:html={accessibilityHtml} />
  <Fragment set:html={emptyHtml} />

  {page.sourceFiles.length > 0 && filesId && (
    <section class="docs-files">
      <h2 id={filesId}>Files</h2>
      <ul>
        {page.sourceFiles.map(file => (
          <li>
            <code>{file.path}</code>
          </li>
        ))}
      </ul>
    </section>
  )}
</DocsLayout>
